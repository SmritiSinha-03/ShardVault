# Optional. Copy to .env to override the defaults in docker-compose.yml.

# MinIO login (also used by the dashboard). Password: 8+ characters.
MINIO_ROOT_USER=shardvault
MINIO_ROOT_PASSWORD=shardvault-secret

# Change these if the ports are already used on your machine.
APP_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
